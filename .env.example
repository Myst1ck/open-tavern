# Backend environment variables

# OpenAI API configuration
# OPENAI_API_KEY=sk-...          # required — docker compose refuses to start without it
# OPENAI_BASE_URL=https://api.openai.com/v1   # env-only; X-Base-URL header removed, not honored
# OPENAI_MODEL=gpt-4o-mini

# CORS origins (comma-separated)
# Add http://<host-ip>:5173 for remote browser access
OPEN_TAVERN_ALLOWED_ORIGINS=http://localhost:5173

# Bearer token required for API access. Unset + localhost bind = warning only;
# unset + non-localhost bind = startup refused (see backend/src/open_tavern/api/main.py).
# OPEN_TAVERN_TOKEN=change-me

# Bind address for the API server (uvicorn --host). Must match the actual bind
# for the tokenless-startup policy to be accurate. docker-compose overrides to
# 0.0.0.0 so the frontend container can reach the API over the docker network.
# OPEN_TAVERN_BIND_HOST=127.0.0.1

# Set to 1 to trust X-Forwarded-For for rate-limit client keys (behind a proxy).
# Default off — header ignored.
# OPEN_TAVERN_TRUST_PROXY=1
