# Backend environment variables

# OpenAI API configuration
# OPENAI_API_KEY=sk-...          # optional — app starts without it; OpenAI
#                                # requests return 503 until set. Can also be
#                                # supplied later via app config (X-API-Key header).
# OPENAI_BASE_URL=https://api.openai.com/v1   # env-only; X-Base-URL header removed, not honored
# OPENAI_MODEL=gpt-4o-mini

# CORS origins (comma-separated)
# Add http://<host-ip>:5173 for remote browser access
OPEN_TAVERN_ALLOWED_ORIGINS=http://localhost:5173

# Bind address for the API server (uvicorn --host). docker-compose overrides to
# 0.0.0.0 so the frontend container can reach the API over the docker network.
# OPEN_TAVERN_BIND_HOST=127.0.0.1

# Host interface docker-compose publishes the backend (8000) and frontend
# (5173) ports on. Defaults to 127.0.0.1 (localhost-only). Set to a LAN/tailnet
# IP to expose the services directly on that interface.
# OPEN_TAVERN_BIND_IP=127.0.0.1

# Set to 1 to trust X-Forwarded-For for rate-limit client keys (behind a proxy).
# Default off — header ignored.
# OPEN_TAVERN_TRUST_PROXY=1
